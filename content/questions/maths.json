  {
    "id": "mat-0007",
    "subject": "maths",
    "topic": "Average",
    "exams": [
      "ssc",
      "railway",
      "bank",
      "state-psc"
    ],
    "difficulty": "medium",
    "answer": 2,
    "en": {
      "q": "The average of 5 numbers is 20. If one number is removed, the average of the rest becomes 18. Which number was removed?",
      "o": [
        "22",
        "26",
        "28",
        "30"
      ],
      "e": "Sum of 5 numbers = 5 × 20 = 100. Sum of the remaining 4 = 4 × 18 = 72. Removed number = 100 − 72 = 28."
    },
    "hi": {
      "q": "5 संख्याओं का औसत 20 है। एक संख्या हटाने पर शेष का औसत 18 हो जाता है। हटाई गई संख्या कौन-सी है?",
      "o": [
        "22",
        "26",
        "28",
        "30"
      ],
      "e": "5 संख्याओं का योग = 5 × 20 = 100। शेष 4 का योग = 4 × 18 = 72। हटाई गई संख्या = 100 − 72 = 28।"
    },
    "source": "Original",
    "added": "2026-09-29"
  },
