# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Every group is optional: the site works without it, and the matching feature switches on once it's set.

# Your domain (used in share links, sitemap and institute join links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Accounts, progress sync, leaderboards, mock history, institutes (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI doubt helper (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-4-5 (fast and cheap)
ANTHROPIC_MODEL=

# Premium payments (Razorpay Dashboard → Account & Settings → API keys, and → Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google AdSense (shown to free users only)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# WhatsApp number for institute enquiries, with country code and no + (e.g. 919876543210)
NEXT_PUBLIC_CONTACT_WHATSAPP=
