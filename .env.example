# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys (Data API). Leave empty to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...). The legacy "anon" key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional login methods
# Set to 0 to hide "Continue with Google"
NEXT_PUBLIC_AUTH_GOOGLE=1
# Set to 1 once an SMS provider is configured in Supabase (Auth → Providers → Phone)
NEXT_PUBLIC_AUTH_PHONE=0
